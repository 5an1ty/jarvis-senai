# Copy to apps/web/.env.local for local Next.js overrides.
# In Netlify, configure these in Environment variables BEFORE building.
# The website works without these variables. The dashboard requires the API.
# NEXT_PUBLIC_API_URL=https://api.your-domain.example
# NEXT_PUBLIC_MOBILE_DOWNLOAD_URL=https://your-domain.example/nexus-home.apk
